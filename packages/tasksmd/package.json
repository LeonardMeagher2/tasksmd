{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@leonardmeagher2/tasksmd",
  "version": "0.3.0",
  "description": "The simplest API for reading and modifying TASKS.md boards — Markdown task checklists with YAML frontmatter",
  "author": {
    "name": "Leonard Meagher",
    "email": "LeonardMeagher2@gmail.com"
  },
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run build.ts",
    "pack": "bun pm pack --dry-run",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "release": "bun publish --tolerate-republish"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "deepmerge": "^4.3.1",
    "yaml": "^2.8.0"
  },
  "keywords": [
    "tasks",
    "tasksmd",
    "markdown",
    "checklist",
    "frontmatter",
    "task-board"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LeonardMeagher2/tasks.git"
  }
}
