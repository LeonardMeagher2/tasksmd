{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@leonardmeagher2/opencode-tasksmd",
  "version": "0.2.0",
  "description": "Background task queue for OpenCode projects, powered by TASKS.md",
  "author": {
    "name": "Leonard Meagher",
    "email": "LeonardMeagher2@gmail.com"
  },
  "type": "module",
  "main": "dist/index.js",
