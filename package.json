{
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --filter '*' build",
    "typecheck": "tsc -p tsconfig.json && bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "pack": "bun run --filter '*' pack",
    "change": "changeset add",
    "version": "changeset version",
    "clean": "bun run scripts/clean.ts",
    "dev": "bun run build && bun run scripts/dev-plugin.ts",
    "fresh": "bun run clean && bun run dev",
    "release": "bun run --parallel --no-exit-on-error --filter '*' release",
    "debug": "bun run --filter '*' debug -- $PWD"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^22",
    "typescript": "^5.9.0"
  }
}